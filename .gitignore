# Publish only the website; everything else in this folder is working material
/*
!/.gitignore
!/index.html
!/favicon.ico
!/favicon.svg
!/apple-touch-icon.png
!/icon-192.png
!/icon-512.png
!/site.webmanifest
!/robots.txt
!/sitemap.xml
!/vercel.json
!/images/
!/fonts/
!/brand_assets/

# Brand files not used by the page
/brand_assets/*
!/brand_assets/team.jpg

.DS_Store
